{
  "name": "A股智能研究平台",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [5173, 8000, 5432, 6379],
  "portsAttributes": {
    "5173": { "label": "Web" },
    "8000": { "label": "API" }
  },
  "postCreateCommand": "npm install && pip install -e '.[dev]'",
  "remoteUser": "vscode",
  "containerEnv": { "APP_ENV": "development", "DEMO_MODE": "true" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"]
    }
  }
}

